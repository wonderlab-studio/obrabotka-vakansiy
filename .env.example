# Фолбэк-цепочка LLM (см. requirements.md, раздел 5.6):
# Уровень A — Groq соло (Cerebras исключён из цепочки — недоступен на аккаунте пользователя,
#   код вызова оставлен в server/llm.js на случай, если понадобится вернуть), резерв — Gemini.
#   Для промпта 5.5.2 (сопоставление тезисов) Groq в цепочке не участвует — хуже соблюдает
#   строгое лексическое правило совпадения, см. requirements.md 5.6 — там уровень A сразу
#   уходит в резерв Gemini.
# Уровень B — Mistral, резерв — Cohere.
# Уровень C — OpenRouter, резерв — Cloudflare Workers AI (заменил GitHub Models — тот в
#   плановом выводе из эксплуатации).
# Финальный резерв — облачная Ollama.
# Если ключ для какого-то звена не задан — оно просто пропускается без сетевого запроса.

# Уровень A
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Резерв уровня A
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Уровень B
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Резерв уровня B
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Уровень C — ключ на https://openrouter.ai/keys (самостоятельная регистрация, без вейтлиста)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Резерв уровня C — Cloudflare Workers AI. CLOUDFLARE_ACCOUNT_ID — из адресной строки
# dash.cloudflare.com (после /accounts/... в разделе Workers AI) либо `wrangler whoami`.
# CLOUDFLARE_TOKEN — API-токен с правом "Workers AI: Read/Edit" (dash.cloudflare.com →
# My Profile → API Tokens). Без account_id провайдер пропускается, даже если токен задан.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Отключён от цепочки — недоступен на аккаунте пользователя (см. requirements.md 5.6).
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Финальный резерв — облачная Ollama (https://ollama.com/settings/keys), платный ключ.
# Модели там называются с суффиксом "-cloud" (см. https://ollama.com/search?c=cloud).
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

PORT=3000
